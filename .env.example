# Configure na hospedagem. Este arquivo não é carregado automaticamente.
# SECRET_KEY (nome antigo) também é aceito.
DJANGO_SECRET_KEY=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
DJANGO_DEBUG=false
# Ative somente quando o proxy confiável sobrescreve X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
DJANGO_CSRF_TRUSTED_ORIGINS=

# Apresentação: configure os nomes reais apenas na hospedagem.
SITE_NAME=Gestão de Provedores e Cobertura
PARTNER_LABEL=Parceiro
# A Render fornece RENDER_EXTERNAL_HOSTNAME automaticamente.
# Domínios personalizados continuam em DJANGO_ALLOWED_HOSTS.
# Integração opcional: caminho privado do arquivo de credencial, nunca no Git.
GOOGLE_SHEETS_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Arquivo local para o script de importação administrativa.
CIDADES_CSV_PATH=
